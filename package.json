  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "dependencies": {
    "@emotion/react": "11.11.1",
    "@emotion/styled": "11.11.0",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "@mui/x-charts": "^9.0.4",
    "@testing-library/jest-dom": "^5.14.1",
    "@testing-library/react": "^11.2.7",
    "@testing-library/user-event": "^12.8.3",
    "apexcharts": "3.40.0",
    "axios": "^1.7.2",
    "bootstrap": "5.1.1",
    "env-cmd": "^10.1.0",
    "final-form": "^5.0.0",
    "leaflet": "^1.9.4",
    "moment": "2.29.4",
    "prop-types": "^15.7.2",
    "react": "19.2.5",
    "react-apexcharts": "1.4.0",
    "react-bootstrap": "2.0.0-rc.0",
    "react-dom": "19.2.5",
    "react-final-form": "^7.0.0",
    "react-gtm-module": "2.0.11",
    "react-icons": "4.3.1",
    "react-leaflet": "^5.0.0",
    "react-leaflet-google-layer": "^2.2.0",
    "react-router-dom": "^5.2.0",
    "react-toastify": "9.0.3",
    "styled-components": "5.3.1"
  },
  "scripts": {
    "lint": "eslint 'src/**/*.{js,jsx}'",
    "lint:fix": "eslint --fix src/containers/**/*.{js,jsx} src/pages/**/*.{js,jsx} src/utils/**/*.{js,jsx} src/components/**/*.{js,jsx}",
    "start": "vite",
    "start:prod": "vite",
    "build": "vite build",
    "build:prod": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "clean": "prettier --write src --ext .js --ext .jsx",
    "prepare": "husky install",
    "deploy:prod": "rm -rf build/ && npm run build:prod && aws s3 sync build/ s3://paulworks.online --acl public-read --profile personal"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not op_mini all"
  ],
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-keywords": "^5.1.0",
    "eslint": "^8.57.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "prettier-eslint": "^16.3.0",
    "prettier-eslint-cli": "^8.0.1",
    "vite": "^5.2.10",
    "@vitejs/plugin-react": "^4.2.1",
    "rimraf": "^5.0.7",
    "eslint-plugin-prettier": "^5.1.3"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --quiet --color"
    ],
    "*.{json,md,html}": [
      "prettier --write"
    ]
  }
}
